<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="切换账户"
        Width="530" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F4F6F9" FontFamily="Microsoft YaHei UI" FontSize="13" ShowInTaskbar="False">
  <StackPanel Margin="26">
    <TextBlock Text="切换 Codex 账户" FontSize="22" FontWeight="SemiBold" Foreground="#16283D"/>
    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,18,0,18">
      <StackPanel><TextBlock Text="目标账户" Foreground="#7A879A"/><TextBlock x:Name="TargetName" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock x:Name="TargetEmail" Foreground="#65758A" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
    </Border>
    <TextBlock x:Name="BackupLabel" Text="先将当前登录保存为" Foreground="#334155"/>
    <TextBox x:Name="BackupName" Padding="10" Margin="0,8,0,8" MaxLength="120"/>
    <TextBlock x:Name="BackupHint" Text="若此备份名称已存在，将更新其中的 auth.json。不能填写目标账户名称。" Foreground="#8A6C43" TextWrapping="Wrap"/>
    <TextBlock Text="确认后替换本地 auth.json 并更新账户记录。已打开的 Codex 客户端可能需要重新启动才能读取新登录。" Foreground="#65758A" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <TextBlock x:Name="SwitchError" Foreground="#BE4242" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelSwitch" Content="取消" IsCancel="True" Padding="24,10" Margin="0,0,10,0"/>
      <Button x:Name="ConfirmSwitch" Content="备份并切换" Padding="24,10" Background="#16866B" Foreground="White"/>
    </StackPanel>
  </StackPanel>
</Window>
