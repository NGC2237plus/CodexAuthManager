<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号操作" Width="570" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F4F6F9" FontFamily="Microsoft YaHei UI" FontSize="13" ShowInTaskbar="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26">
    <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Foreground="#16283D"/>
    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,14"><StackPanel>
      <TextBlock x:Name="IdentityText" TextWrapping="Wrap" FontSize="15" Foreground="#21364D"/>
      <TextBlock x:Name="TargetText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#16866B"/>
    </StackPanel></Border>
    <StackPanel x:Name="NamePanel"><TextBlock Text="保存名称（可选）"/><TextBox x:Name="NameInput" Padding="10" Margin="0,7,0,10" MaxLength="120"/></StackPanel>
    <StackPanel x:Name="MatchPanel" Visibility="Collapsed"><TextBlock Text="同一身份有多份备份，请选择要更新的一份" TextWrapping="Wrap"/><ComboBox x:Name="MatchChoice" Padding="8" Margin="0,7,0,10"/></StackPanel>
    <StackPanel x:Name="AppPanel" Visibility="Collapsed"><TextBlock Text="Codex 桌面程序"/><DockPanel Margin="0,7,0,10"><Button x:Name="BrowseApp" Content="选择…" DockPanel.Dock="Right" Padding="10,8" Margin="8,0,0,0"/><TextBox x:Name="AppPath" IsReadOnly="True" Padding="8" TextWrapping="Wrap"/></DockPanel></StackPanel>
    <TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="#65758A" Margin="0,0,0,8"/>
    <TextBlock x:Name="ActionError" TextWrapping="Wrap" Foreground="#BE4242"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" IsCancel="True" Padding="24,10" Margin="0,0,10,0"/><Button x:Name="ConfirmAction" Content="确认" Padding="20,10" Background="#16866B" Foreground="White"/></StackPanel>
  </StackPanel></ScrollViewer>
</Window>
